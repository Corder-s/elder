# ElderCare OS Environment Variables Example
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eldercareos

# Authentication & Sessions
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars_long
JWT_EXPIRES_IN=7d
MFA_ENCRYPTION_KEY=replace_with_32_byte_hex_or_passphrase_for_totp_encryption

# Email Provider (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@eldercareos.com

# Multi-Tenancy & Cookies
ROOT_DOMAIN=localhost:3000
SESSION_COOKIE_NAME=eldercare_session

# S3 / Object Storage (Private Tenant Partitioning)
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=eldercareos-tenant-storage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# SaaS Billing (Razorpay - Foundation Mode)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder
